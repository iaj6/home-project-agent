{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "outDir": "lib",
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@home-helper/shared": ["../shared/src"]
    },
    "rootDirs": ["src", "../shared/src"]
  },
  "include": ["src", "../shared/src"],
  "exclude": ["node_modules"]
}
